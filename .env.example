APP_ENV=development
APP_ORIGIN=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1000
# Set a conservative input+output budget within the selected model's context window.
AI_CONTEXT_WINDOW_TOKENS=8192
# Leave blank to infer from AI_MODEL; specify a supported tiktoken encoding if needed.
AI_TOKEN_ENCODING=
CHAT_CONTEXT_TURNS=5
CHAT_CONTEXT_MAX_CHARS=12000
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Production only: domain with DNS pointing to the instance (no scheme).
APP_DOMAIN=chat.example.com
